	"steps": [
		{
			"text": "<highlight>Generic Organic Immunity System</highlight>"
		},
		{
			"text": "Note: To make a QL75+ building, regular or advanced, you need a #L \"Solid Clump of Kyr'Ozch Bio-Material\" \"254804\" and a #L \"Manteze Scout Nasal Membrane\" \"247762\"."
		},
		{
			"text": "The QL of the Clump of Bio-Material sets the QL of the Generic Organic Immunity System (and the building)."
		},
		{
			"source": "Kyr'Ozch Structural Analyzer",
			"target": "Solid Clump of Kyr'Ozch Bio-Material",
			"result": "Kyr'Ozch Viral Serum",
			"skills": "4.5 x QL EE"
		},
		{
			"text": "Note: Refining a clump of bio material does not guarantee viral serum as a result."
		},
		{
			"text": "They can turn into several different items."
		},
		{
			"source": "Advanced Bio-Comminutor",
			"target": "Manteze Scout Nasal Membrane",
			"result": "Membrane Pulp",
			"skills": "400 PH"
		},
		{
			"source": "Membrane Pulp",
			"target": "Kyr'Ozch Viral Serum",
			"result": "Generic Organic Immunity System (QL75+)",
			"skills": "3.5 x QL PH"
		},
		{
			"text": "<highlight>Regular Building</highlight>"
		},
		{
			"source": "Generic Volatile Nanobots",
			"target": "HSR Compressed Regenerating Bioplate",
